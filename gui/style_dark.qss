/* 深色主题：全暗色配色 */

/* === 基础 === */
QWidget {
    color: #d4d4d8;
    font-family: "Microsoft YaHei UI", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background: #1e1f22;
}

/* 菜单栏 */
QMenuBar {
    background: #25262b;
    border-bottom: 1px solid #2e2f35;
    padding: 2px 8px;
    font-size: 13px;
}
QMenuBar::item {
    padding: 4px 12px;
    border-radius: 4px;
    color: #d4d4d8;
}
QMenuBar::item:selected {
    background: #2e2f35;
}

/* === 导航栏 === */
#navBar {
    background: #25262b;
    border-right: 1px solid #2e2f35;
}

NavButton {
    background: transparent;
    color: #8f959e;
    border: none;
    border-radius: 8px;
    margin: 2px 10px;
    padding: 8px 4px;
    font-size: 11px;
}
NavButton:hover {
    background: #2a2d32;
    color: #c9cdd4;
}
NavButton:checked {
    background: #3370ff;
    color: #ffffff;
}
NavButton:checked:hover {
    background: #3370ff;
    color: #ffffff;
}

#navMinBtn {
    background: transparent;
    color: #8f959e;
    border: none;
    border-radius: 8px;
    margin: 2px 10px;
    padding: 8px 4px;
    font-size: 11px;
}
#navMinBtn:hover {
    background: #2a2d32;
    color: #c9cdd4;
}
#navMinBtn:disabled {
    color: #4a4d52;
}

/* === 工作区通用 === */
#viewTitle {
    font-size: 20px;
    font-weight: 600;
    color: #f0f1f2;
}

#dashboardTitle {
    font-size: 24px;
    font-weight: 600;
    color: #f0f1f2;
}

#dashboardSub {
    color: #8f959e;
    font-size: 12px;
}

/* 状态卡片 */
#statusCard {
    background: #25262b;
    border: 1px solid #2e2f35;
    border-radius: 10px;
}
#statusCard:hover {
    border-color: #3e3f45;
}

#cardTitle {
    color: #8f959e;
    font-size: 12px;
    font-weight: 500;
}

/* 提示框 */
#tipBox {
    background: #25262b;
    border: 1px solid #2e2f35;
    border-radius: 10px;
}

#tipTitle {
    color: #f0f1f2;
    font-size: 14px;
    font-weight: 600;
}

#tipItem {
    color: #a9aeb8;
    font-size: 13px;
}

/* === 按钮 === */
QPushButton {
    background: #2e2f35;
    color: #d4d4d8;
    border: 1px solid #3e3f45;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 13px;
}
QPushButton:hover {
    background: #353640;
    border-color: #4e5969;
}
QPushButton:pressed {
    background: #25262b;
}
QPushButton:disabled {
    color: #5a5d62;
    background: #1e1f22;
    border-color: #2e2f35;
}

#primaryBtn {
    background: #3370ff;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 14px;
    font-weight: 500;
}
#primaryBtn:hover {
    background: #2860f0;
}
#primaryBtn:pressed {
    background: #1f54d8;
}
#primaryBtn:disabled {
    background: #1a3a6b;
    color: #5a7ab5;
}

#dangerBtn {
    background: #2e2f35;
    color: #f87171;
    border: 1px solid #5a2a2a;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 14px;
    font-weight: 500;
}
#dangerBtn:hover {
    background: #3a2a2a;
    border-color: #f87171;
}
#dangerBtn:pressed {
    background: #2a1a1a;
}
#dangerBtn:disabled {
    color: #5a3a3a;
    background: #1e1f22;
    border-color: #2e2f35;
}

#linkBtn {
    background: transparent;
    color: #5b9eff;
    border: none;
    text-align: left;
    padding: 4px 0;
    font-size: 13px;
}
#linkBtn:hover {
    color: #7ab0ff;
}
#linkBtn:disabled {
    color: #3a5a8a;
}

/* === 输入控件 === */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #2e2f35;
    border: 1px solid #3e3f45;
    border-radius: 6px;
    padding: 6px 10px;
    color: #d4d4d8;
    selection-background-color: #3370ff;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #3370ff;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: #1e1f22;
    color: #5a5d62;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background: #2e2f35;
    border: 1px solid #3e3f45;
    border-radius: 6px;
    selection-background-color: #3370ff;
    selection-color: #ffffff;
    color: #d4d4d8;
    outline: none;
}

QCheckBox {
    spacing: 8px;
    color: #d4d4d8;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3e3f45;
    border-radius: 4px;
    background: #2e2f35;
}
QCheckBox::indicator:hover {
    border-color: #3370ff;
}
QCheckBox::indicator:checked {
    background: #3370ff;
    border-color: #3370ff;
}

/* === 列表/表格 === */
QListWidget {
    background: #25262b;
    border: 1px solid #2e2f35;
    border-radius: 8px;
    padding: 6px;
    color: #d4d4d8;
    outline: none;
}
QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
    color: #d4d4d8;
}
QListWidget::item:selected {
    background: #1a3a6b;
    color: #5b9eff;
}
QListWidget::item:hover {
    background: #2e2f35;
}

QTableWidget {
    background: #25262b;
    border: 1px solid #2e2f35;
    border-radius: 8px;
    gridline-color: #2e2f35;
    color: #d4d4d8;
    selection-background-color: #1a3a6b;
    selection-color: #5b9eff;
    outline: none;
}
QTableWidget::item {
    padding: 4px 8px;
}
QTableWidget::item:selected {
    background: #1a3a6b;
    color: #5b9eff;
}
QHeaderView::section {
    background: #1e1f22;
    color: #8f959e;
    border: none;
    border-bottom: 1px solid #2e2f35;
    border-right: 1px solid #2e2f35;
    padding: 8px 10px;
    font-weight: 500;
    font-size: 12px;
}

/* === 分组框 === */
QGroupBox {
    background: #25262b;
    border: 1px solid #2e2f35;
    border-radius: 10px;
    margin-top: 14px;
    padding: 20px 16px 16px 16px;
    font-weight: 500;
    color: #f0f1f2;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    background: #1e1f22;
    color: #f0f1f2;
    font-size: 13px;
    font-weight: 600;
}

/* === 日志窗口 === */
LogTextEdit {
    background: #1a1b1e;
    color: #d4d4d8;
    border: 1px solid #2e2f35;
    border-radius: 8px;
    padding: 12px;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 12px;
}

/* === 滚动条 === */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3e3f45;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #4e5969;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3e3f45;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #4e5969;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* === 对话框 === */
QDialog {
    background: #25262b;
}

QMessageBox {
    background: #25262b;
}
QMessageBox QLabel {
    color: #d4d4d8;
    font-size: 13px;
}

/* === 工具提示 === */
QToolTip {
    background: #1e1f22;
    color: #d4d4d8;
    border: 1px solid #3e3f45;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
